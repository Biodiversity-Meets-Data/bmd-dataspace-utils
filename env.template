# The docker image tag of the bmd-dataspace-utils image to use.
# NB: this is not the *git* tag (or commit hash or branch) of the Cubing Engine
# included in the Docker image. Each image is pinned (via the Dockerfile) to a
# specific version of the Cubing Engine.
IMAGE_VERSION=main

# The host system directory to which to write the data cubes. Will be mapped to
# container directory /output inside the container. Make sure the directory
# exists before running the container.
CUBE_OUTPUT_DIR=/data/bmd/cubes

GBIF_USER=
GBIF_MAIL=
GBIF_PWD=
